# Example Environment Configuration for Expo React Native App
# Copy this file to .env and adjust the values for your setup.

# Base API URL for backend services
# For physical devices on local network: http://<YOUR_LOCAL_IP>:8000/api/v1
# For Android emulator: http://10.0.2.2:8000/api/v1
# For iOS simulator: http://localhost:8000/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1
