APP_APP_NAME=ExpanceTracker API
APP_APP_VERSION=1.0.0
APP_DEBUG=false
APP_API_V1_PREFIX=/api/v1
APP_DATABASE_URL=postgresql://username:password@localhost:5432/database_name
APP_GEMINI_API_KEY=your_gemini_api_key_here
APP_LLM_PROVIDER=ollama
APP_LLM_MODEL=llama3.2
APP_OLLAMA_BASE_URL=http://localhost:11434
APP_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# --- Redis Settings ---
REDIS_URL=redis://localhost:6379/0
APP_REDIS_URL=redis://localhost:6379/0

# --- Email / Brevo Configuration (Optional in development; OTPs log to console if omitted) ---
# Option 1: Brevo REST API (Recommended - fast & works even when SMTP ports are blocked)
# Get your API Key from: https://app.brevo.com/settings/keys/api
APP_BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Sender Details (Note: Sender email must be a verified sender in your Brevo account)
APP_EMAILS_FROM_EMAIL=noreply@yourdomain.com
APP_EMAILS_FROM_NAME=ExpenseTracker

# Option 2: Brevo SMTP Relay / Standard SMTP (Used if APP_BREVO_API_KEY is not set)
# Brevo SMTP host is smtp-relay.brevo.com (port 587)
APP_SMTP_HOST=smtp-relay.brevo.com
APP_SMTP_PORT=587
APP_SMTP_USER=your_brevo_login_email@example.com
APP_SMTP_PASSWORD=your_brevo_smtp_key_here
APP_SMTP_TLS=true
